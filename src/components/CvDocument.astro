---
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/jetbrains-mono/index.css';
import { getImage } from 'astro:assets';
import cvImage from '../assets/cv_image.jpg';
import { getProfile, socialLinks } from '../data/profile';
import { getExperience } from '../data/experience';
import { getEducation } from '../data/education';
import { getSkills } from '../data/skills';
import type { Locale } from '../data/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const profile = getProfile(locale);
const experience = getExperience(locale);
const education = getEducation(locale);
const skills = getSkills(locale);

const labels = locale === 'en'
  ? {
      photoAlt: 'Photo of',
      profile: 'Profile',
      experience: 'Work experience',
      education: 'Education',
      skills: 'Skills',
      languages: 'Languages',
      details: 'Details',
      availability: 'Availability',
      personality: 'Personality',
      privacy:
        'I authorise the processing of my personal data contained in this CV pursuant to Regulation (EU) 2016/679 (GDPR) for recruitment and selection purposes.',
    }
  : {
      photoAlt: 'Fotografia di',
      profile: 'Profilo',
      experience: 'Esperienza professionale',
      education: 'Formazione',
      skills: 'Competenze',
      languages: 'Lingue',
      details: 'Informazioni',
      availability: 'Disponibilità',
      personality: 'Personalità',
      privacy:
        'Autorizzo il trattamento dei miei dati personali presenti nel CV ai sensi del D.Lgs. 196/2003 e del Regolamento (UE) 2016/679 (GDPR) ai fini della ricerca e selezione del personale.',
    };

// Nel CV stampato mostriamo solo i canali professionali
const professionalLinks = socialLinks.filter(l => l.icon === 'linkedin' || l.icon === 'github');

// Foto profilo: ~24mm di lato, 400px ≈ 420 dpi in stampa
const photo = await getImage({ src: cvImage, width: 400, height: 400, format: 'jpg' });

// L'ultima voce "Stack: ..." di ogni esperienza viene resa come riga
// tecnologie dedicata, separata dai bullet descrittivi
function splitStack(description: string[]): { bullets: string[]; stack: string | null } {
  const stackItem = description.find(d => d.startsWith('Stack:'));
  return {
    bullets: description.filter(d => !d.startsWith('Stack:')),
    stack: stackItem ? stackItem.replace(/^Stack:\s*/, '').replace(/\.$/, '') : null,
  };
}
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{profile.name} — Curriculum Vitae</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --ink: #1c1d20;
      --ink-soft: #45464c;
      --muted: #6d6e74;
      --accent: #b4531f;       /* terracotta scurita per contrasto in stampa */
      --rule: #e4e1da;
      --rule-strong: #c9c5bc;
      --serif: 'Fraunces Variable', 'Fraunces', Georgia, serif;
      --sans: 'Inter Variable', 'Inter', 'Segoe UI', Arial, sans-serif;
      --mono: 'JetBrains Mono Variable', 'JetBrains Mono', Consolas, monospace;
    }

    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    body {
      font-family: var(--sans);
      font-size: 9.5pt;
      color: var(--ink);
      background: #fff;
      line-height: 1.45;
    }

    /* Contenitore A4: i margini verticali li gestisce Puppeteer,
       qui solo il gutter orizzontale */
    .page {
      width: 210mm;
      margin: 0 auto;
      padding: 0 16mm;
    }
    /* Anteprima a schermo (dev): simula il foglio */
    @media screen {
      body { background: #ececec; }
      .page {
        background: #fff;
        padding: 14mm 16mm;
        margin: 8mm auto;
        box-shadow: 0 2px 18px rgba(0, 0, 0, 0.14);
        min-height: 297mm;
      }
    }

    a { color: inherit; text-decoration: none; }

    /* ── HEADER ─────────────────────────────── */
    .cv-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10mm;
      padding-bottom: 5mm;
      border-bottom: 0.6pt solid var(--rule-strong);
      margin-bottom: 6mm;
    }
    .header-left {
      display: flex;
      align-items: center;
      gap: 5.5mm;
    }
    .cv-photo {
      width: 24mm;
      height: 24mm;
      object-fit: cover;
      border-radius: 2.5mm;
      border: 0.4pt solid var(--rule-strong);
      display: block;
      flex-shrink: 0;
    }
    .cv-header h1 {
      font-family: var(--serif);
      font-size: 25pt;
      font-weight: 560;
      letter-spacing: -0.02em;
      line-height: 1.02;
      color: var(--ink);
      font-variation-settings: 'opsz' 96;
    }
    .cv-header .title {
      font-family: var(--mono);
      font-size: 8.5pt;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--accent);
      margin-top: 2.2mm;
    }

    .contacts {
      text-align: right;
      font-size: 8pt;
      color: var(--ink-soft);
      line-height: 1.9;
      flex-shrink: 0;
    }
    .contacts .contact-line { white-space: nowrap; }
    .contacts svg {
      width: 8pt;
      height: 8pt;
      vertical-align: -1pt;
      margin-left: 4pt;
      stroke: var(--accent);
    }
    .contacts a:hover { color: var(--accent); }

    /* ── TITOLI DI SEZIONE ──────────────────── */
    .section { margin-bottom: 6mm; }

    .section-title {
      display: flex;
      align-items: baseline;
      gap: 2.4mm;
      font-family: var(--mono);
      font-size: 7.5pt;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--ink);
      margin-bottom: 3.5mm;
      break-after: avoid;
    }
    .section-title::before {
      content: '';
      width: 6mm;
      height: 2.2pt;
      background: var(--accent);
      align-self: center;
      flex-shrink: 0;
    }
    .section-title::after {
      content: '';
      flex: 1;
      height: 0.4pt;
      background: var(--rule);
      align-self: center;
    }

    /* ── PROFILO ────────────────────────────── */
    .about-text {
      font-size: 9.5pt;
      color: var(--ink-soft);
      line-height: 1.55;
      max-width: 165mm;
    }

    /* ── LAYOUT A DUE COLONNE ───────────────── */
    .columns {
      display: grid;
      grid-template-columns: 1fr 56mm;
      column-gap: 9mm;
      align-items: start;
    }
    .col-side {
      border-left: 0.4pt solid var(--rule);
      padding-left: 6mm;
    }
    /* Le sezioni compatte della sidebar non si spezzano tra le pagine */
    .col-side .keep-together { break-inside: avoid; }

    /* ── ESPERIENZA / FORMAZIONE ────────────── */
    .entry {
      margin-bottom: 5mm;
      break-inside: avoid;
    }
    .entry:last-child { margin-bottom: 0; }

    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 6mm;
    }
    .entry-role {
      font-family: var(--serif);
      font-weight: 620;
      font-size: 11pt;
      letter-spacing: -0.01em;
      color: var(--ink);
      font-variation-settings: 'opsz' 40;
    }
    .entry-period {
      font-family: var(--mono);
      font-size: 7pt;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      white-space: nowrap;
    }
    .entry-meta {
      font-size: 8.5pt;
      margin-top: 0.8mm;
      color: var(--muted);
    }
    .entry-meta .entry-company {
      color: var(--accent);
      font-weight: 600;
    }

    .entry-bullets {
      list-style: none;
      margin-top: 1.8mm;
    }
    .entry-bullets li {
      position: relative;
      padding-left: 4.5mm;
      font-size: 9pt;
      color: var(--ink-soft);
      margin-bottom: 1mm;
      line-height: 1.45;
    }
    .entry-bullets li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--accent);
      font-family: var(--serif);
    }

    .entry-stack {
      margin-top: 1.6mm;
      font-family: var(--mono);
      font-size: 7pt;
      letter-spacing: 0.04em;
      color: var(--muted);
    }
    .entry-stack strong {
      color: var(--ink-soft);
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* ── SIDEBAR: COMPETENZE / LINGUE / INFO ── */
    .side-block { margin-bottom: 5mm; break-inside: avoid; }
    .side-block:last-child { margin-bottom: 0; }

    .skill-category {
      font-size: 7.5pt;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--ink);
      margin-bottom: 1.2mm;
    }
    .skill-items {
      font-size: 8.5pt;
      color: var(--ink-soft);
      line-height: 1.6;
      overflow-wrap: break-word;
    }

    .lang-item,
    .info-item {
      display: flex;
      justify-content: space-between;
      gap: 3mm;
      font-size: 8.5pt;
      color: var(--ink-soft);
      padding: 1mm 0;
      border-bottom: 0.4pt solid var(--rule);
    }
    .lang-item:last-child,
    .info-item:last-child { border-bottom: none; }
    .lang-item b,
    .info-item b { color: var(--ink); font-weight: 600; }
    .lang-item span,
    .info-item span { text-align: right; }

    /* ── NOTA PRIVACY ───────────────────────── */
    .privacy {
      margin-top: 7mm;
      padding-top: 2.5mm;
      border-top: 0.4pt solid var(--rule);
      font-size: 6.8pt;
      color: var(--muted);
      font-style: italic;
      line-height: 1.5;
    }
  </style>
</head>
<body>
<div class="page">

  <!-- HEADER -->
  <header class="cv-header">
    <div class="header-left">
      <img
        class="cv-photo"
        src={photo.src}
        alt={`${labels.photoAlt} ${profile.name}`}
        width="400"
        height="400"
      />
      <div>
        <h1>{profile.name}</h1>
        <div class="title">{profile.title}</div>
      </div>
    </div>
    <div class="contacts">
      <div class="contact-line">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
      </div>
      {professionalLinks.map(l => (
        <div class="contact-line">
          <a href={l.href}>{l.href.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</a>
          {l.icon === 'linkedin' ? (
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4v2a6 6 0 0 1 2-2z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          )}
        </div>
      ))}
      <div class="contact-line">
        {profile.location}
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
      </div>
    </div>
  </header>

  <!-- PROFILO -->
  <section class="section">
    <h2 class="section-title">{labels.profile}</h2>
    <p class="about-text">{profile.bio}</p>
  </section>

  <div class="columns">

    <!-- COLONNA PRINCIPALE -->
    <div class="col-main">

      <!-- ESPERIENZA -->
      <section class="section">
        <h2 class="section-title">{labels.experience}</h2>
        {experience.map(exp => {
          const { bullets, stack } = splitStack(exp.description);
          return (
            <article class="entry">
              <div class="entry-header">
                <h3 class="entry-role">{exp.role}</h3>
                <span class="entry-period">{exp.period}</span>
              </div>
              <div class="entry-meta">
                <span class="entry-company">{exp.company}</span>
                {' — '}{exp.location}
              </div>
              <ul class="entry-bullets">
                {bullets.map(d => <li>{d}</li>)}
              </ul>
              {stack && (
                <p class="entry-stack"><strong>Stack</strong> · {stack}</p>
              )}
            </article>
          );
        })}
      </section>

      <!-- FORMAZIONE -->
      <section class="section">
        <h2 class="section-title">{labels.education}</h2>
        {education.map(edu => (
          <article class="entry">
            <div class="entry-header">
              <h3 class="entry-role">{edu.degree}</h3>
              <span class="entry-period">{edu.year}</span>
            </div>
            <div class="entry-meta">
              <span class="entry-company">{edu.institution}</span>
              {' — '}{edu.field}
            </div>
            {edu.description && (
              <ul class="entry-bullets">
                {edu.description.map(d => <li>{d}</li>)}
              </ul>
            )}
          </article>
        ))}
      </section>

    </div>

    <!-- SIDEBAR -->
    <aside class="col-side">

      <section class="section">
        <h2 class="section-title">{labels.skills}</h2>
        {skills.map(s => (
          <div class="side-block">
            <div class="skill-category">{s.category}</div>
            <div class="skill-items">{s.items.join(' · ')}</div>
          </div>
        ))}
      </section>

      <section class="section keep-together">
        <h2 class="section-title">{labels.languages}</h2>
        {profile.languages.map(l => {
          const [lang, level] = l.split(/\s*—\s*/);
          return (
            <div class="lang-item">
              <b>{lang}</b>
              <span>{level}</span>
            </div>
          );
        })}
      </section>

      <section class="section keep-together">
        <h2 class="section-title">{labels.details}</h2>
        <div class="info-item">
          <b>{labels.availability}</b>
          <span>{profile.availability}</span>
        </div>
        <div class="info-item">
          <b>{labels.personality}</b>
          <span>{profile.mbti} (MBTI)</span>
        </div>
        <div class="info-item">
          <b>Portfolio</b>
          <span><a href="https://gianlucazaccarelli.github.io">gianlucazaccarelli.github.io</a></span>
        </div>
      </section>

    </aside>
  </div>

  <!-- NOTA PRIVACY (standard per i CV italiani) -->
  <p class="privacy">{labels.privacy}</p>

</div>
</body>
</html>
