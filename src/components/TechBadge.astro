---
import { techIcon } from '../data/icons';

interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = techIcon(name);
// Indaco solo per i prodotti reali (devicons); i concetti (Lucide) restano neutri
const isProduct = !!icon && !icon.includes('/lucide-');
---

<span class:list={['tech-badge', { 'is-product': isProduct }]}>
  {icon && <img src={icon} alt="" width="12" height="12" loading="lazy" decoding="async" class="tech-icon" />}
  {name}
</span>

<style>
  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 999px;
    color: var(--color-ink-700);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  :global(.dark) .tech-badge {
    color: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .tech-badge.is-product {
    border-color: color-mix(in oklch, var(--color-brand-600) 30%, transparent);
    color: var(--color-brand-700);
  }

  :global(.dark) .tech-badge.is-product {
    border-color: color-mix(in oklch, var(--color-brand-200) 30%, transparent);
    color: var(--color-brand-100);
  }

  .tech-icon {
    width: 12px;
    height: 12px;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
