---
import { techIcon } from '../data/icons';

interface Props {
  name: string;
}

const { name } = Astro.props;
const icon = techIcon(name);
---

<span class:list={['tech-badge', { 'has-icon': !!icon }]}>
  {icon && <img src={icon} alt="" width="12" height="12" loading="lazy" decoding="async" class="tech-icon" />}
  {name}
</span>

<style>
  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.18rem 0.55rem;
    font-size: 0.65rem;
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 999px;
    color: var(--color-ink-700);
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  :global(.dark) .tech-badge {
    color: rgba(255, 255, 255, 0.7);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .tech-badge.has-icon {
    border-color: rgba(69, 92, 233, 0.3);
    color: var(--color-brand-700);
  }

  :global(.dark) .tech-badge.has-icon {
    border-color: rgba(165, 180, 252, 0.25);
    color: #c7d2fe;
  }

  .tech-icon {
    width: 12px;
    height: 12px;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
