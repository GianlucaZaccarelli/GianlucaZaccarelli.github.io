---
import { getSkills } from '../data/skills';
import { techIcon } from '../data/icons';
import type { Locale } from '../data/types';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const skills = getSkills(locale);
const labels = locale === 'en'
  ? { title: 'Tech stack' }
  : { title: 'Competenze tecniche' };

// Cluster view: each category on its own
const clusters = skills.map(s => ({
  ...s,
  items: s.items.map(name => ({ name, icon: techIcon(name) })),
}));
---

<section id="skills" class="relative py-24 md:py-32 bg-white dark:bg-surface overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">

    <h2 class="section-title">
      <span class="section-num" aria-hidden="true">04</span>{labels.title}
    </h2>

    <!-- Cluster view -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-12">
      {clusters.map(cluster => (
        <div class="group">
          <div class="flex items-baseline gap-3 mb-5 pb-3 border-b border-ink-300/40 dark:border-white/10">
            <h3 class="text-base font-semibold leading-none text-ink-900 dark:text-white">
              {cluster.category}
            </h3>
            <span class="flex-1 h-px bg-ink-300/30 dark:bg-white/8"></span>
            <span class="meta-mono text-[0.65rem] text-ink-500 dark:text-white/55">
              {cluster.items.length}
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            {cluster.items.map(item => (
              <div class="skill-chip">
                {item.icon && (
                  <img src={item.icon} alt="" width="16" height="16" loading="lazy" decoding="async" class="skill-icon" />
                )}
                <span>{item.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .skill-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgba(0, 0, 0, 0.12);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-ink-700);
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s, background 0.2s, transform 0.2s;
    cursor: default;
  }

  :global(.dark) .skill-chip {
    background: transparent;
    border-color: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.8);
  }

  .skill-chip:hover {
    border-color: var(--color-accent-500);
    color: var(--color-accent-700);
    background: color-mix(in oklch, var(--color-accent-500) 8%, transparent);
    transform: translateY(-1px);
  }

  :global(.dark) .skill-chip:hover {
    color: var(--color-accent-400);
  }

  .skill-icon {
    width: 16px;
    height: 16px;
    object-fit: contain;
    flex-shrink: 0;
  }
</style>
