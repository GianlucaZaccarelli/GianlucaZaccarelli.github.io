---
import type { Locale } from '../data/types';

interface Props {
  locale?: Locale;
}
const { locale = 'it' } = Astro.props;
// Quattro saluti, il primo nella lingua della pagina: l'intro resta sotto 1,5 s
// (prima visita: e' cio' che ritarda la comparsa dell'hero)
const words = locale === 'en'
  ? ['Hello', 'Ciao', 'Bonjour', 'こんにちは']
  : ['Ciao', 'Hello', 'Bonjour', 'こんにちは'];
---

<!-- Senza JS l'overlay non verrebbe mai rimosso -->
<noscript><style>.loading-container { display: none !important; }</style></noscript>

<div class="loading-container" aria-hidden="true">
  <div class="loading-screen">

    <!-- Griglia di punti sottile -->
    <div class="ls-grid"></div>

    <!-- Parole al centro (decorative: niente heading) -->
    <div class="loading-words">
      {words.map((word, i) => (
        <div class:list={[
          'loading-word',
          'home-active',
          { 'home-active-first': i === 0 },
          { 'home-active-last': i === words.length - 1 },
          { 'jap': word === 'こんにちは' }
        ]}>
          {word}<div class="dot"></div>
        </div>
      ))}
    </div>

    <!-- Footer con contatore e barra progresso -->
    <div class="ls-footer">
      <span class="ls-name">Gianluca Zaccarelli</span>
      <div class="ls-right">
        <span class="ls-counter"><span id="ls-count">0</span>%</span>
      </div>
    </div>
    <div class="ls-progress-track">
      <div class="ls-progress-bar" id="ls-bar"></div>
    </div>

    <!-- Bordo curvo in basso -->
    <div class="rounded-div-wrap bottom">
      <div class="rounded-div"></div>
    </div>

  </div>
</div>

<style>
  /* ── Container ── */
  /* .no-intro viene messa su <html> da BaseLayout prima del paint
     (intro già vista, movimento ridotto o storage non disponibile) */
  :global(.no-intro) .loading-container {
    display: none;
  }
  .loading-container {
    position: fixed;
    inset: 0;
    z-index: 9000;
    pointer-events: none;
    overflow: hidden;
  }

  .loading-screen {
    position: relative;
    width: 100%;
    height: 100%;
    background: var(--color-surface-alt);
    overflow: hidden;
  }

  /* ── Griglia punti ── */
  .ls-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
    background-size: 40px 40px;
    opacity: 0;
    animation: gridFade 1.2s ease 0.3s forwards;
  }

  @keyframes gridFade {
    to { opacity: 1; }
  }

  /* ── Parole ── */
  .loading-words {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }

  .loading-word {
    margin: 0;
    padding: 0 0.4em 0 0.6em;
    color: #fff;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    display: none;
    white-space: nowrap;
    font-size: clamp(3.25em, 5vw, 4.5em);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .loading-word.jap {
    font-size: calc(clamp(3.25em, 5vw, 4.5em) * 0.55);
    transform: translate(-50%, 25%);
  }

  .dot {
    display: block;
    position: absolute;
    border-radius: 50%;
    background: var(--color-accent-500);
    left: 0;
    top: 47%;
    width: calc(clamp(16px, 1.2vw, 19px) / 1.65);
    height: calc(clamp(16px, 1.2vw, 19px) / 1.65);
  }

  @media screen and (max-width: 540px) {
    .dot { top: 42%; }
  }

  /* ── Footer ── */
  .ls-footer {
    position: absolute;
    bottom: 2.5rem;
    left: 2rem;
    right: 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    opacity: 0;
    animation: gridFade 0.8s ease 0.6s forwards;
  }

  .ls-name {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .ls-counter {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    font-variant-numeric: tabular-nums;
    font-weight: 500;
  }

  #ls-count {
    color: #fff;
    font-weight: 700;
    font-size: 1rem;
  }

  /* ── Progress bar ── */
  .ls-progress-track {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: rgba(255, 255, 255, 0.06);
  }

  .ls-progress-bar {
    height: 100%;
    width: 100%;
    background: var(--color-accent-500);
    transform-origin: left center;
    transform: scaleX(0);
  }

  /* ── Curva in basso ── */
  .rounded-div-wrap {
    position: absolute;
    width: 110%;
    left: -5%;
    overflow: hidden;
    z-index: 2;
  }

  /* Curva ad altezza fissa: si chiude con scaleY, niente animazione di height */
  .rounded-div-wrap.bottom {
    bottom: 0;
    height: 10vh;
    transform: translateY(99%);
    transform-origin: top center;
  }
  @media screen and (max-width: 540px) {
    .rounded-div-wrap.bottom { height: 5vh; }
  }

  .rounded-div-wrap .rounded-div {
    width: 100%;
    height: 745%;
    background: var(--color-surface-alt);
    border-radius: 50%;
  }
</style>

<script>
  (function () {
    if (document.documentElement.classList.contains('no-intro')) return;

    const isMobile = window.innerWidth <= 540;
    const screen = document.querySelector<HTMLElement>('.loading-screen');
    const container = document.querySelector<HTMLElement>('.loading-container');
    const wordsEl = document.querySelector<HTMLElement>('.loading-words');
    const words = Array.from(document.querySelectorAll<HTMLElement>('.loading-words .loading-word'));
    const bar = document.getElementById('ls-bar');
    const count = document.getElementById('ls-count');
    const curve = document.querySelector<HTMLElement>('.loading-screen .rounded-div-wrap.bottom');
    const onceIn = Array.from(document.querySelectorAll<HTMLElement>('main .once-in'));

    if (!screen || !container || !wordsEl || !bar || !curve) return;

    // Sotto l'intro la pagina non e' raggiungibile da tastiera (lo skip link resta sopra)
    const sotto = Array.from(document.body.children).filter(
      (el) => el !== container && !el.classList.contains('skip-to-content') && el.tagName !== 'SCRIPT'
    ) as HTMLElement[];
    sotto.forEach((el) => (el.inert = true));

    // Init
    document.documentElement.style.cursor = 'wait';
    document.body.style.overflow = 'hidden';
    onceIn.forEach((el) => (el.style.transform = `translateY(${isMobile ? '10vh' : '50vh'})`));
    words.forEach((w) => ((w.style.display = 'block'), (w.style.opacity = '0')));
    const first = words[0];
    const last = words[words.length - 1];
    if (first) first.style.opacity = '1';

    // Tempi (ms): ogni parola resta a schermo `step`, il contatore dura quanto il ciclo
    const DELAY_MS = 150;
    const cycleStart = DELAY_MS + 150;
    const step = 200;
    const LOAD_MS = cycleStart - DELAY_MS + step * words.length;

    // Contatore 0 → 100 + barra progresso
    const startCounter = performance.now() + DELAY_MS;
    let finito = false;
    function tickCounter(now: number) {
      const t = finito ? 1 : Math.min(1, Math.max(0, (now - startCounter) / LOAD_MS));
      const eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
      if (count) count.textContent = String(Math.round(eased * 100));
      if (bar) bar.style.transform = `scaleX(${eased})`;
      if (t < 1) requestAnimationFrame(tickCounter);
    }
    requestAnimationFrame(tickCounter);

    // Fade-in contenitore parole
    wordsEl.animate(
      [{ opacity: 0 }, { opacity: 1 }],
      { duration: 500, delay: DELAY_MS, fill: 'forwards', easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
    );

    // Ciclo parole: fade rapido in/out, testo pieno per quasi tutto lo `step`
    words.forEach((w, i) => {
      if (i === 0) {
        w.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 1, delay: cycleStart + step, fill: 'forwards' });
        return;
      }
      const isLast = w === last;
      const keyframes = isLast
        ? [{ opacity: 0 }, { opacity: 1 }]
        : [{ opacity: 0 }, { opacity: 1, offset: 0.15 }, { opacity: 1, offset: 0.85 }, { opacity: 0 }];
      w.animate(keyframes, {
        duration: isLast ? 1 : step,
        delay: cycleStart + step * i,
        fill: 'forwards',
      });
    });

    // Uscita: la tendina sale con transform (niente top/height: nessuno spostamento di layout)
    const EASE = 'cubic-bezier(0.76, 0, 0.24, 1)';
    const SALTA = ['keydown', 'pointerdown', 'wheel', 'touchstart'];
    function esci() {
      if (finito) return;
      finito = true;
      window.clearTimeout(timer);
      SALTA.forEach((t) => window.removeEventListener(t, esci));

      screen!.animate([{ transform: 'none' }, { transform: 'translateY(-100%)' }], { duration: 700, easing: EASE, fill: 'forwards' });
      curve!.animate(
        [{ transform: 'translateY(99%) scaleY(1)' }, { transform: 'translateY(99%) scaleY(0)' }],
        { duration: 850, easing: EASE, fill: 'forwards' }
      );
      wordsEl!.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 300, fill: 'forwards', easing: 'linear' });
      sotto.forEach((el) => (el.inert = false));

      // Animazione contenuto principale (stagger)
      onceIn.forEach((el, i) => {
        el.style.transition = `transform 1500ms cubic-bezier(0.16, 1, 0.3, 1) ${i * 70}ms`;
        el.style.transform = 'translateY(0)';
      });

      window.setTimeout(() => {
        document.documentElement.style.cursor = 'auto';
      }, 550);

      window.setTimeout(() => {
        document.body.style.overflow = '';
        container!.style.display = 'none';
        onceIn.forEach((el) => {
          el.style.transition = '';
          el.style.transform = '';
        });
        try {
          sessionStorage.setItem('zakka:intro-seen', '1');
        } catch {
          /* storage non disponibile: l'intro si ripeterà */
        }
      }, 1200);
    }

    // Finisce da sola dopo l'ultimo saluto; un tasto, un tocco o la rotella la saltano
    const timer = window.setTimeout(esci, cycleStart + step * words.length + 200);
    SALTA.forEach((t) => window.addEventListener(t, esci, { passive: true }));
  })();
</script>
