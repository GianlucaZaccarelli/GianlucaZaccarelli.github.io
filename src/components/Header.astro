---
import { Picture } from 'astro:assets';
import { getProfile } from '../data/profile';
import type { Locale } from '../data/types';
import mainImage from '../assets/foto/hero-ritratto-bn.jpg';
import FlagIcon from './FlagIcon.astro';
import LogoMark from './LogoMark.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const profile = getProfile(locale);

const itHref = import.meta.env.BASE_URL || '/';
const enHref = `${itHref.replace(/\/$/, '')}/en/`;

const labels = locale === 'en'
  ? {
      about: 'About',
      skills: 'Skills',
      experience: 'Experience',
      education: 'Education',
      projects: 'Projects',
      contacts: 'Contact',
      themeToggle: 'Toggle theme',
      darkTheme: 'Dark theme',
      lightTheme: 'Light theme',
      downloadCv: 'Download CV (PDF)',
      openPrintableCv: 'Open printable CV',
      downloadCvAria: 'Download CV in PDF',
      openPrintableCvAria: 'Open printable CV',
      located: 'Based',
      openMenu: 'Open menu',
      closeMenu: 'Close menu',
      sections: 'Sections',
      backToTop: 'back to top',
      scroll: 'Scroll',
      brandTag: 'Senior Full-Stack Dev',
      language: 'Language',
      writeMe: 'Email me',
    }
  : {
      about: 'Chi sono',
      skills: 'Competenze',
      experience: 'Esperienza',
      education: 'Formazione',
      projects: 'Progetti',
      contacts: 'Contatti',
      themeToggle: 'Cambia tema',
      darkTheme: 'Tema scuro',
      lightTheme: 'Tema chiaro',
      downloadCv: 'Scarica CV (PDF)',
      openPrintableCv: 'Apri CV stampabile',
      downloadCvAria: 'Scarica CV in PDF',
      openPrintableCvAria: 'Apri CV stampabile',
      located: 'Vivo',
      openMenu: 'Apri il menu',
      closeMenu: 'Chiudi il menu',
      sections: 'Sezioni',
      backToTop: "torna all'inizio",
      scroll: 'Scorri',
      brandTag: 'Senior Full-Stack Dev',
      language: 'Lingua',
      writeMe: 'Scrivimi',
    };

const navItems = [
  { href: '#about',      label: labels.about      },
  { href: '#experience', label: labels.experience },
  { href: '#education',  label: labels.education  },
  { href: '#skills',     label: labels.skills     },
  { href: '#projects',   label: labels.projects   },
  { href: '#contact',    label: labels.contacts   },
];

const cvHref = import.meta.env.DEV ? (locale === 'en' ? '/cv-print-en' : '/cv-print') : profile.cvPath;
const isCvDownload = !import.meta.env.DEV;

function toRoman(n: number): string {
  const numerals: Array<[number, string]> = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
    [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let out = '';
  for (const [value, symbol] of numerals) {
    while (n >= value) { out += symbol; n -= value; }
  }
  return out;
}
const yearRoman = toRoman(new Date().getFullYear());
---

<header
  id="top"
  class="site-header fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- Bottom accent line -->
  <div class="header-accent absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-500/50 to-transparent"></div>

  <nav class="max-w-6xl mx-auto px-6 py-3 grid grid-cols-[auto_1fr] lg:grid-cols-[auto_1fr_auto] items-center gap-6">

    <!-- Logo / Name -->
    <a href="#top" class="group brand-mark flex items-center gap-2.5 no-underline whitespace-nowrap" aria-label={`${profile.name}, ${profile.title} — ${labels.backToTop}`}>
      <LogoMark class="brand-logo" />
      <span class="hidden xl:inline-flex h-4 w-px bg-ink-300/60 dark:bg-white/15"></span>
      <span class="hidden xl:inline text-xs text-ink-500 dark:text-white/60 font-medium leading-none">
        {labels.brandTag}
      </span>
    </a>

    <!-- Tab bar -->
    <div class="hidden lg:flex justify-center">
      <ul
        class="tab-bar relative inline-flex items-center gap-1 p-1 rounded-full border border-ink-300/60 dark:border-white/10 bg-white/60 dark:bg-white/5 backdrop-blur-sm"
      >
        <!-- Segnaposto che scivola sotto la voce attiva (posizionato dallo scrollspy) -->
        <li class="tab-indicator" aria-hidden="true"></li>
        {navItems.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-target={href}
              class="tab-link relative inline-flex items-center px-3.5 py-1.5 rounded-full text-[0.82rem] font-medium text-ink-500 dark:text-white/55 hover:text-ink-900 dark:hover:text-white transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 justify-self-end">
      <!-- Language toggle -->
      <div
        role="group"
        aria-label={labels.language}
        class="lang-toggle hidden lg:inline-flex items-center p-0.5 rounded-full border border-ink-300/60 dark:border-white/15 bg-white/60 dark:bg-white/5"
      >
        <a
          href={itHref}
          aria-label="Italiano"
          title="Italiano"
          class:list={['lang-option', { 'is-active': locale === 'it' }]}
          aria-current={locale === 'it' ? 'page' : undefined}
        >
          <FlagIcon country="it" />
        </a>
        <a
          href={enHref}
          aria-label="English"
          title="English"
          class:list={['lang-option', { 'is-active': locale === 'en' }]}
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          <FlagIcon country="gb" />
        </a>
      </div>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        data-theme-toggle
        aria-label={labels.themeToggle}
        aria-pressed="false"
        data-tooltip={labels.darkTheme}
        data-label-dark={labels.darkTheme}
        data-label-light={labels.lightTheme}
        class="theme-toggle cursor-pointer relative w-9 h-9 hidden lg:flex items-center justify-center rounded-full"
      >
        <svg class="theme-toggle-icon icon-sun w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <g class="sun-rays">
            <line x1="12" y1="2" x2="12" y2="4"/>
            <line x1="12" y1="20" x2="12" y2="22"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="2" y1="12" x2="4" y2="12"/>
            <line x1="20" y1="12" x2="22" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </g>
        </svg>
        <svg class="theme-toggle-icon icon-moon w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Download CV -->
      <a
        href={cvHref}
        download={isCvDownload}
        data-tooltip={isCvDownload ? labels.downloadCv : labels.openPrintableCv}
        aria-label={isCvDownload ? labels.downloadCvAria : labels.openPrintableCvAria}
        class="cv-button group inline-flex items-center gap-2 text-[0.82rem] font-semibold px-4 py-2 rounded-full transition-all"
      >
        <svg class="w-3 h-3 transition-transform group-hover:translate-y-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        CV
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        aria-label={labels.openMenu}
        data-label-close={labels.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="menu-toggle lg:hidden cursor-pointer relative w-11 h-11 flex items-center justify-center rounded-full"
      >
        <span class="menu-bar menu-bar-top"></span>
        <span class="menu-bar menu-bar-bottom"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div id="mobile-menu" class="mobile-menu lg:hidden">
    <nav aria-label={labels.sections}>
      <ul class="mobile-menu-list">
        {navItems.map(({ href, label }, i) => (
          <li>
            <a href={href} data-target={href} class="mobile-menu-link" style={`--i: ${i}`}>
              <span class="mobile-menu-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="mobile-menu-label">{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mobile-menu-tools">
      <div class="mobile-tools-row" role="group" aria-label={labels.language}>
        <a
          href={itHref}
          class:list={['mobile-tool', { 'is-active': locale === 'it' }]}
          aria-current={locale === 'it' ? 'page' : undefined}
        >
          <FlagIcon country="it" /> Italiano
        </a>
        <a
          href={enHref}
          class:list={['mobile-tool', { 'is-active': locale === 'en' }]}
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          <FlagIcon country="gb" /> English
        </a>
      </div>
      <div class="mobile-tools-row">
        <button
          type="button"
          data-theme-toggle
          aria-pressed="false"
          data-label-dark={labels.darkTheme}
          data-label-light={labels.lightTheme}
          class="mobile-tool cursor-pointer"
        >
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"/>
          </svg>
          <span data-theme-label>{labels.darkTheme}</span>
        </button>
        <a href={`mailto:${profile.email}`} class="mobile-tool">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-10 6L2 7"/>
          </svg>
          {labels.writeMe}
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Folio da rivista: sezione corrente + avanzamento della lettura (decorativo, da md) -->
<aside id="folio" class="folio" aria-hidden="true">
  <span class="folio-bar"></span>
  <span class="folio-text">
    <span class="folio-num"></span>
    <span class="folio-label"></span>
  </span>
</aside>

<!-- ── HERO ──────────────────────────────────────────── -->
<section id="hero" class="hero-section" aria-labelledby="hero-title">

  <!-- Immagine centrale con parallax -->
  <div class="hero-img-wrap" id="hero-bg">
    <!-- AVIF (circa 40% piu' leggero) con WebP di riserva: e' l'elemento LCP -->
    <Picture
      src={mainImage}
      alt={profile.name}
      formats={['avif', 'webp']}
      pictureAttributes={{ style: 'display: contents' }}
      widths={[640, 960, 1280, 1920]}
      sizes="(max-width: 720px) 100vw, 90vh"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <!-- Noise texture overlay -->
    <div class="grain-overlay"></div>
    <!-- Vignette -->
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>

  <!-- Colonna sinistra -->
  <div class="hero-col hero-col-left">
    <div class="hero-location-badge">
      <span class="hero-index">N° 00 / Portfolio</span>
      <p class="hero-subtitle">
        <span>{labels.located}</span>
        in {profile.country}
      </p>
      <p class="hero-availability">— {profile.city}</p>
    </div>
    <div class="hero-scroll-hint">
      <div class="hero-scroll-line"></div>
      <span>{labels.scroll}</span>
    </div>
  </div>

  <!-- Colonna destra -->
  <div class="hero-col hero-col-right">
    <div class="hero-right-top">
      <span class="hero-mbti">{profile.mbti} · {yearRoman}</span>
    </div>
    <div class="hero-right-center">
      <h1 id="hero-title" class="hero-subtitle">
        <span class="hero-name">{profile.name}<span class="sr-only"> — </span></span>
        <span>{profile.titleLead}</span>
        <em>{profile.titleRest}</em>
      </h1>
      <p class="hero-facts">{profile.facts}</p>
      <p class="hero-hook">{profile.hook}</p>
      <p class="hero-availability">{profile.availability}</p>
    </div>
  </div>

  <!-- Marquee rolling name (bottom) -->
  <div class="hero-marquee-wrap" aria-hidden="true">
    <div class="hero-marquee-inner" id="hero-marquee-inner">
      <span class="hero-marquee-text">{profile.name}<em>—</em></span>
    </div>
  </div>

</section>

<style>
  /* ── Header background + blur ── */
  .site-header {
    background: rgba(255, 255, 255, 0.80);
    transition: background-color 0.35s ease;
  }
  /* Il blur sta su uno pseudo-elemento: un backdrop-filter sull'header
     lo renderebbe il containing block del menu mobile (position: fixed),
     che resterebbe alto quanto l'header invece di coprire la viewport */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    pointer-events: none;
  }
  :global(.dark) .site-header {
    background: rgba(28, 29, 32, 0.85);
  }
  /* Sopra la hero (sempre scura) l'header diventa vetro scuro,
     così in light mode non appare una banda bianca sull'immagine */
  .site-header.over-hero,
  :global(.dark) .site-header.over-hero {
    background: rgba(15, 16, 18, 0.35);
  }
  .site-header.over-hero .header-accent {
    opacity: 0;
  }
  .header-accent {
    transition: opacity 0.35s ease;
  }
  /* Su mobile il blur costa troppo: fallback opaco */
  @media (max-width: 720px) {
    .site-header {
      background: rgba(255, 255, 255, 0.96);
    }
    .site-header::before {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    :global(.dark) .site-header {
      background: rgba(28, 29, 32, 0.96);
    }
    /* Nero pieno come la copertina: il testo dell'hero non passa in trasparenza */
    .site-header.over-hero,
    :global(.dark) .site-header.over-hero {
      background: #0f1012;
    }
  }

  /* ── Folio ── */
  /* Corre in verticale lungo il margine sinistro, come il dorso di una rivista:
     da xl il margine è abbastanza largo da non toccare il testo */
  .folio {
    position: fixed;
    left: 1.25rem;
    bottom: 2rem;
    z-index: 40;
    display: none;
    align-items: center;
    gap: 0.9rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  @media (min-width: 1280px) {
    .folio { display: flex; }
  }
  .folio.is-visible {
    opacity: 1;
  }
  .folio-text {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-500);
  }
  .folio-num {
    color: var(--color-accent-600);
    font-variant-numeric: tabular-nums;
  }
  :global(.dark) .folio-text { color: rgba(255, 255, 255, 0.6); }
  :global(.dark) .folio-num { color: var(--color-accent-400); }
  /* Sopra il retro di copertina terracotta il folio passa al colore carta */
  .folio.is-on-cover .folio-text,
  .folio.is-on-cover .folio-num { color: var(--color-paper); }
  .folio.is-on-cover .folio-bar { background: color-mix(in oklch, var(--color-paper) 30%, transparent); }
  .folio.is-on-cover .folio-bar::after { background: var(--color-paper); }
  /* Il filo è il primo figlio: ruotato di 180°, sta in basso e cresce verso l'alto */
  .folio-bar {
    position: relative;
    width: 1px;
    height: 7.5rem;
    background: color-mix(in oklch, var(--color-ink-300) 60%, transparent);
    overflow: hidden;
  }
  :global(.dark) .folio-bar { background: rgba(255, 255, 255, 0.14); }
  .folio-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent-500);
    transform-origin: center top;
    transform: scaleY(0);
  }
  /* Il filo si riempie con la lettura della pagina; senza scroll-timeline resta un filetto */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .folio-bar::after {
        animation: folio-progress linear both;
        animation-timeline: scroll(root);
      }
    }
  }
  @keyframes folio-progress {
    to { transform: scaleY(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .folio { transition: none; }
  }

  /* ── Hero Section ── */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: #0f1012;
    display: flex;
    align-items: center;
  }

  /* ── Immagine centrale ── */
  .hero-img-wrap {
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 110%;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  .hero-img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    /* Su viewport strette il ritratto sborda: il crop segue il viso,
       che nella foto sta a destra del centro */
    object-position: center top;
    display: block;
    pointer-events: none;
    user-select: none;
    filter: grayscale(20%) contrast(1.05);
    /* Gradiente laterale per far emergere le colonne */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 18%,
      black 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 18%,
      black 82%,
      transparent 100%
    );
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, transparent 40%, rgba(15,16,18,0.55) 100%),
      linear-gradient(to bottom, transparent 60%, rgba(15,16,18,0.9) 100%);
  }

  /* ── Colonne laterali ── */
  .hero-col {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
    padding: clamp(1.5rem, 3vw, 3rem);
  }
  .hero-col-left  { left: 0;  align-items: flex-start; }
  .hero-col-right { right: 0; align-items: flex-end; }

  /* Left: location badge */
  .hero-location-badge {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hero-index {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    align-self: flex-start;
    margin-bottom: 0.2rem;
  }

  /* Left: scroll hint */
  .hero-scroll-hint {
    position: absolute;
    bottom: calc(max(3.25rem, 5.5vw) + 2rem);
    left: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.6);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero-scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent);
    animation: scrollLine 1.8s ease-in-out infinite;
  }
  @keyframes scrollLine {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line { animation: none; }
  }

  /* Right: top MBTI (l'offset extra evita la barra fixed dell'header) */
  .hero-right-top {
    position: absolute;
    top: calc(clamp(1.5rem, 3vw, 3rem) + 3.5rem);
    right: clamp(1.5rem, 3vw, 3rem);
  }
  .hero-mbti {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  /* Right: subtitle centered */
  .hero-right-center {
    text-align: right;
  }
  .hero-subtitle {
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.1vw, 1.9rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.6rem 0;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 96, 'SOFT' 100;
  }
  .hero-subtitle span {
    display: block;
    font-style: normal;
    font-weight: 500;
  }
  .hero-subtitle .hero-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .hero-subtitle em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent-400);
  }
  .hero-facts {
    max-width: 30ch;
    text-wrap: balance;
    margin: 0 0 1.1rem auto;
    line-height: 1.6;
