  /* ── Responsive ── */
  @media (max-width: 720px) {
    /* Libera il centro (viso del ritratto): location in alto a sinistra,
       titolo in basso a destra sopra il marquee */
    .hero-col-left  { padding: 1.25rem; justify-content: flex-start; padding-top: 5.5rem; }
    .hero-col-right { padding: 1.25rem; justify-content: flex-end; padding-bottom: 6.5rem; }
    .hero-subtitle  { font-size: 1.15rem; }
    .hero-img {
      /* Rimuovo filter (grayscale+contrast) e mask laterale soft: troppo costoso sul mobile */
      filter: none;
      -webkit-mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 10%,
        black 90%,
        transparent 100%
      );
      mask-image: linear-gradient(
        to right,
        transparent 0%,
        black 10%,
        black 90%,
        transparent 100%
      );
    }
    .hero-mbti {
      backdrop-filter: none;
    }
