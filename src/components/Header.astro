  /* Sopra la hero la pillola poggia sull'immagine scura: serve più
     opacità di fondo e testo più scuro per restare leggibile */
  .site-header.over-hero .tab-bar {
    background: rgba(255, 255, 255, 0.85);
    border-color: rgba(255, 255, 255, 0.4);
  }
  :global(.dark) .site-header.over-hero .tab-bar {
