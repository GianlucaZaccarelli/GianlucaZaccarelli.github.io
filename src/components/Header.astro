  /* ── Theme toggle (subtle animated) ── */
  .theme-toggle {
    color: #b4531f;
    background: rgba(192, 97, 26, 0.14);
    border: 1px solid rgba(192, 97, 26, 0.45);
    transition: color 0.35s ease, background-color 0.3s ease,
                border-color 0.3s ease, transform 0.2s ease,
                box-shadow 0.3s ease;
  }
  :global(.dark) .theme-toggle {
    color: #c7d2fe;
    background: rgba(165, 180, 252, 0.14);
    border-color: rgba(165, 180, 252, 0.4);
  }
  /* Sopra la hero (sfondo scuro) serve una versione chiara e luminosa;
     in dark mode resta l'indigo, in light diventa arancio caldo */
  .site-header.over-hero .theme-toggle {
    color: #ffc08a;
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 190, 138, 0.55);
  }
  :global(.dark) .site-header.over-hero .theme-toggle {
    color: #c7d2fe;
    background: rgba(165, 180, 252, 0.14);
    border-color: rgba(165, 180, 252, 0.5);
  }
  .theme-toggle:hover {
    background: rgba(192, 97, 26, 0.16);
    border-color: rgba(192, 97, 26, 0.4);
    color: #9a4a10;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px -4px rgba(192, 97, 26, 0.35);
  }
  :global(.dark) .theme-toggle:hover {
    background: rgba(165, 180, 252, 0.16);
    border-color: rgba(165, 180, 252, 0.4);
    color: #c7d2fe;
    box-shadow: 0 4px 12px -4px rgba(165, 180, 252, 0.35);
  }
  .site-header.over-hero .theme-toggle:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 211, 173, 0.8);
    color: #ffd3ad;
    box-shadow: 0 4px 12px -4px rgba(255, 190, 138, 0.4);
  }
  :global(.dark) .site-header.over-hero .theme-toggle:hover {
    background: rgba(165, 180, 252, 0.22);
    border-color: rgba(199, 210, 254, 0.75);
    color: #e0e7ff;
    box-shadow: 0 4px 12px -4px rgba(165, 180, 252, 0.45);
  }
  .theme-toggle:active {
    transform: scale(0.95);
  }

  .theme-toggle-icon {
    position: absolute;
    transition: transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 0.3s ease;
  }
  .icon-sun {
    transform: rotate(0deg) scale(1);
    opacity: 1;
  }
  .icon-moon {
    transform: rotate(-90deg) scale(0.5);
    opacity: 0;
