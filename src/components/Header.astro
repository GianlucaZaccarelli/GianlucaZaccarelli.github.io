---
import { Image } from 'astro:assets';
import { getProfile } from '../data/profile';
import type { Locale } from '../data/types';
import mainImage from '../assets/MainImage.jpg';
import FlagIcon from './FlagIcon.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const profile = getProfile(locale);

const itHref = import.meta.env.BASE_URL || '/';
const enHref = `${itHref.replace(/\/$/, '')}/en/`;

const labels = locale === 'en'
  ? {
      about: 'About',
      skills: 'Skills',
      experience: 'Experience',
      education: 'Education',
      projects: 'Projects',
      contacts: 'Contact',
      themeToggle: 'Toggle theme',
      darkTheme: 'Dark theme',
      lightTheme: 'Light theme',
      downloadCv: 'Download CV (PDF)',
      openPrintableCv: 'Open printable CV',
      downloadCvAria: 'Download CV in PDF',
      openPrintableCvAria: 'Open printable CV',
      located: 'Based',
      openMenu: 'Open menu',
      closeMenu: 'Close menu',
      sections: 'Sections',
    }
  : {
      about: 'Chi sono',
      skills: 'Competenze',
      experience: 'Esperienza',
      education: 'Formazione',
      projects: 'Progetti',
      contacts: 'Contatti',
      themeToggle: 'Cambia tema',
      darkTheme: 'Tema scuro',
      lightTheme: 'Tema chiaro',
      downloadCv: 'Scarica CV (PDF)',
      openPrintableCv: 'Apri CV stampabile',
      downloadCvAria: 'Scarica CV in PDF',
      openPrintableCvAria: 'Apri CV stampabile',
      located: 'Vivo',
      openMenu: 'Apri il menu',
      closeMenu: 'Chiudi il menu',
      sections: 'Sezioni',
    };

const navItems = [
  { href: '#about',      label: labels.about      },
  { href: '#experience', label: labels.experience },
  { href: '#education',  label: labels.education  },
  { href: '#skills',     label: labels.skills     },
  { href: '#projects',   label: labels.projects   },
  { href: '#contact',    label: labels.contacts   },
];

const cvHref = import.meta.env.DEV ? (locale === 'en' ? '/cv-print-en' : '/cv-print') : profile.cvPath;
const isCvDownload = !import.meta.env.DEV;

function toRoman(n: number): string {
  const numerals: Array<[number, string]> = [
    [1000, 'M'], [900, 'CM'], [500, 'D'], [400, 'CD'], [100, 'C'], [90, 'XC'],
    [50, 'L'], [40, 'XL'], [10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I'],
  ];
  let out = '';
  for (const [value, symbol] of numerals) {
    while (n >= value) { out += symbol; n -= value; }
  }
  return out;
}
const yearRoman = toRoman(new Date().getFullYear());
---

<header
  id="top"
  class="site-header fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <!-- Bottom accent line -->
  <div class="header-accent absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-accent-500/50 to-transparent"></div>

  <nav class="max-w-6xl mx-auto px-6 py-3 grid grid-cols-[auto_1fr_auto] items-center gap-6">

    <!-- Logo / Name -->
    <a href="#top" class="group brand-mark flex items-center gap-2.5 no-underline whitespace-nowrap">
      <span class="brand-word font-serif text-xl tracking-tight text-ink-900 dark:text-white italic select-none leading-none" style="font-variation-settings: 'opsz' 96, 'SOFT' 100;">
        {profile.nickname}
      </span>
      <span class="hidden xl:inline-flex h-4 w-px bg-ink-300/60 dark:bg-white/15"></span>
      <span class="hidden xl:inline font-mono text-[0.6rem] uppercase tracking-[0.16em] text-ink-500 dark:text-white/60 font-medium leading-none">
        Full-Stack Dev
      </span>
    </a>

    <!-- Tab bar -->
    <div class="hidden lg:flex justify-center">
      <ul
        class="tab-bar inline-flex items-center gap-1 p-1 rounded-full border border-ink-300/60 dark:border-white/10 bg-white/60 dark:bg-white/5 backdrop-blur-sm"
      >
        {navItems.map(({ href, label }) => (
          <li>
            <a
              href={href}
              data-target={href}
              class="tab-link relative inline-flex items-center px-3.5 py-1.5 rounded-full font-mono text-[0.7rem] uppercase tracking-[0.12em] font-medium text-ink-500 dark:text-white/55 hover:text-ink-900 dark:hover:text-white transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2 justify-self-end">
      <!-- Language toggle -->
      <div
        role="group"
        aria-label="Language"
        class="lang-toggle inline-flex items-center p-0.5 rounded-full border border-ink-300/60 dark:border-white/15 bg-white/60 dark:bg-white/5"
      >
        <a
          href={itHref}
          aria-label="Italiano"
          title="Italiano"
          class:list={['lang-option', { 'is-active': locale === 'it' }]}
          aria-current={locale === 'it' ? 'page' : undefined}
        >
          <FlagIcon country="it" />
        </a>
        <a
          href={enHref}
          aria-label="English"
          title="English"
          class:list={['lang-option', { 'is-active': locale === 'en' }]}
          aria-current={locale === 'en' ? 'page' : undefined}
        >
          <FlagIcon country="gb" />
        </a>
      </div>

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        aria-label={labels.themeToggle}
        aria-pressed="false"
        data-tooltip={labels.darkTheme}
        data-label-dark={labels.darkTheme}
        data-label-light={labels.lightTheme}
        class="theme-toggle cursor-pointer relative w-9 h-9 flex items-center justify-center rounded-full"
      >
        <svg class="theme-toggle-icon icon-sun w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <g class="sun-rays">
            <line x1="12" y1="2" x2="12" y2="4"/>
            <line x1="12" y1="20" x2="12" y2="22"/>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
            <line x1="2" y1="12" x2="4" y2="12"/>
            <line x1="20" y1="12" x2="22" y2="12"/>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
          </g>
        </svg>
        <svg class="theme-toggle-icon icon-moon w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <!-- Download CV -->
      <a
        href={cvHref}
        download={isCvDownload}
        data-tooltip={isCvDownload ? labels.downloadCv : labels.openPrintableCv}
        aria-label={isCvDownload ? labels.downloadCvAria : labels.openPrintableCvAria}
        class="cv-button group inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.14em] font-medium px-4 py-2.5 rounded-full transition-all"
      >
        <svg class="w-3 h-3 transition-transform group-hover:translate-y-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
          <polyline points="7 10 12 15 17 10"/>
          <line x1="12" y1="15" x2="12" y2="3"/>
        </svg>
        CV
      </a>

      <!-- Mobile menu toggle -->
      <button
        id="menu-toggle"
        aria-label={labels.openMenu}
        data-label-close={labels.closeMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="menu-toggle lg:hidden cursor-pointer relative w-9 h-9 flex items-center justify-center rounded-full"
      >
        <span class="menu-bar menu-bar-top"></span>
        <span class="menu-bar menu-bar-bottom"></span>
      </button>
    </div>
  </nav>

  <!-- Mobile menu overlay -->
  <div id="mobile-menu" class="mobile-menu lg:hidden">
    <nav aria-label={labels.sections}>
      <ul class="mobile-menu-list">
        {navItems.map(({ href, label }, i) => (
          <li>
            <a href={href} class="mobile-menu-link">
              <span class="mobile-menu-num">·{String(i + 1).padStart(2, '0')}</span>
              <span class="mobile-menu-label">{label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- ── HERO ──────────────────────────────────────────── -->
<section id="hero" class="hero-section">

  <!-- Immagine centrale con parallax -->
  <div class="hero-img-wrap" id="hero-bg">
    <Image
      src={mainImage}
      alt={profile.name}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-img"
    />
    <!-- Noise texture overlay -->
    <div class="grain-overlay"></div>
    <!-- Vignette -->
    <div class="hero-vignette" aria-hidden="true"></div>
  </div>

  <!-- Colonna sinistra -->
  <div class="hero-col hero-col-left">
    <div class="hero-location-badge">
      <span class="hero-index">N° 00 / Portfolio</span>
      <p class="hero-subtitle">
        <span>{labels.located}</span>
        in {profile.country}
      </p>
      <p class="hero-availability">— {profile.city}</p>
    </div>
    <div class="hero-scroll-hint">
      <div class="hero-scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>

  <!-- Colonna destra -->
  <div class="hero-col hero-col-right">
    <div class="hero-right-top">
      <span class="hero-mbti">{profile.mbti} · {yearRoman}</span>
    </div>
    <div class="hero-right-center">
      <h1 class="hero-subtitle">
        <span class="sr-only">{profile.name} — </span>
        <span>{profile.titleLead}</span>
        <em>{profile.titleRest}</em>
      </h1>
      <p class="hero-availability">{profile.availability}</p>
    </div>
  </div>

  <!-- Marquee rolling name (bottom) -->
  <div class="hero-marquee-wrap" aria-hidden="true">
    <div class="hero-marquee-inner" id="hero-marquee-inner">
      <span class="hero-marquee-text">{profile.name}<em>—</em></span>
    </div>
  </div>

</section>

<style>
  /* ── Header background + blur ── */
  .site-header {
    background: rgba(255, 255, 255, 0.80);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: background-color 0.35s ease;
  }
  :global(.dark) .site-header {
    background: rgba(28, 29, 32, 0.85);
  }
  /* Sopra la hero (sempre scura) l'header diventa vetro scuro,
     così in light mode non appare una banda bianca sull'immagine */
  .site-header.over-hero,
  :global(.dark) .site-header.over-hero {
    background: rgba(15, 16, 18, 0.35);
  }
  .site-header.over-hero .header-accent {
    opacity: 0;
  }
  .header-accent {
    transition: opacity 0.35s ease;
  }
  /* Su mobile il blur costa troppo: fallback opaco */
  @media (max-width: 720px) {
    .site-header {
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    :global(.dark) .site-header {
      background: rgba(28, 29, 32, 0.96);
    }
    .site-header.over-hero,
    :global(.dark) .site-header.over-hero {
      background: rgba(15, 16, 18, 0.45);
    }
  }

  /* ── Hero Section ── */
  .hero-section {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: #0f1012;
    display: flex;
    align-items: center;
  }

  /* ── Immagine centrale ── */
  .hero-img-wrap {
    position: absolute;
    top: -10%;
    left: 0;
    width: 100%;
    height: 110%;
    will-change: transform;
    display: flex;
    justify-content: center;
    overflow: hidden;
  }
  .hero-img {
    width: auto;
    max-width: 100%;
    height: 100%;
    object-fit: cover;
    /* Su viewport strette il ritratto sborda: il crop segue il viso,
       che nella foto sta a destra del centro */
    object-position: 80% top;
    display: block;
    pointer-events: none;
    user-select: none;
    filter: grayscale(20%) contrast(1.05);
    /* Gradiente laterale per far emergere le colonne */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 18%,
      black 82%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 18%,
      black 82%,
      transparent 100%
    );
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at center, transparent 40%, rgba(15,16,18,0.55) 100%),
      linear-gradient(to bottom, transparent 60%, rgba(15,16,18,0.9) 100%);
  }

  /* ── Colonne laterali ── */
  .hero-col {
    position: absolute;
    top: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 2;
    padding: clamp(1.5rem, 3vw, 3rem);
  }
  .hero-col-left  { left: 0;  align-items: flex-start; }
  .hero-col-right { right: 0; align-items: flex-end; }

  /* Left: location badge */
  .hero-location-badge {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .hero-index {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(255,255,255,0.2);
    align-self: flex-start;
    margin-bottom: 0.2rem;
  }

  /* Left: scroll hint */
  .hero-scroll-hint {
    position: absolute;
    bottom: clamp(1.5rem, 3vw, 3rem);
    left: clamp(1.5rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.6);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }
  .hero-scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.3), transparent);
    animation: scrollLine 1.8s ease-in-out infinite;
  }
  @keyframes scrollLine {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-line { animation: none; }
  }

  /* Right: top MBTI (l'offset extra evita la barra fixed dell'header) */
  .hero-right-top {
    position: absolute;
    top: calc(clamp(1.5rem, 3vw, 3rem) + 3.5rem);
    right: clamp(1.5rem, 3vw, 3rem);
  }
  .hero-mbti {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    padding: 0.35rem 0.75rem;
    border: 1px solid rgba(255,255,255,0.25);
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  /* Right: subtitle centered */
  .hero-right-center {
    text-align: right;
  }
  .hero-subtitle {
    color: #fff;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.1vw, 1.9rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.6rem 0;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 96, 'SOFT' 100;
  }
  .hero-subtitle span {
    display: block;
    font-style: normal;
    font-weight: 500;
  }
  .hero-subtitle em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent-400, #e8a28c);
  }
  .hero-availability {
    color: rgba(255,255,255,0.72);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }

  /* ── Marquee ── */
  .hero-marquee-wrap {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    z-index: 3;
    padding: 0.3rem 0;
    border-top: 1px solid rgba(255,255,255,0.06);
    background: linear-gradient(to top, rgba(28,29,32,0.9), rgba(28,29,32,0.5));
  }
  .hero-marquee-inner {
    display: inline-flex;
    white-space: nowrap;
    will-change: transform;
  }
  .hero-marquee-text {
    font-family: var(--font-serif);
    font-size: max(3.25rem, 5.5vw);
    font-weight: 400;
    letter-spacing: -0.045em;
    color: #fff;
    padding-right: 0.4em;
    line-height: 1;
    display: inline-block;
    user-select: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 100;
  }
  .hero-marquee-text em {
    font-style: italic;
    color: var(--color-accent-400, #e8a28c);
    padding: 0 0.15em;
  }

  /* ── Brand mark ── */
  .brand-mark {
    padding: 0.42rem 0.85rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(28, 29, 32, 0.10);
    background: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(248,246,241,0.85));
    box-shadow:
      0 1px 0 rgba(255,255,255,0.75) inset,
      0 8px 24px rgba(15,16,18,0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  :global(.dark) .brand-mark {
    border-color: rgba(255,255,255,0.12);
    background: linear-gradient(180deg, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
    box-shadow:
      0 1px 0 rgba(255,255,255,0.06) inset,
      0 10px 24px rgba(0,0,0,0.18);
  }
  .brand-mark:hover {
    transform: translateY(-1px);
    border-color: rgba(192, 97, 26, 0.28);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.8) inset,
      0 10px 28px rgba(15,16,18,0.12);
  }
  :global(.dark) .brand-mark:hover {
    border-color: rgba(232, 162, 140, 0.28);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.08) inset,
      0 12px 28px rgba(0,0,0,0.24);
  }
  .brand-word {
    font-size: 1.12rem;
    letter-spacing: -0.07em;
    /* Il corsivo sborda dall'inline box e background-clip: text lo
       taglierebbe: il padding estende l'area dipinta, il margine compensa */
    padding: 0.05em 0.14em 0.08em 0.05em;
    margin: -0.05em -0.14em -0.08em -0.05em;
    /* Gradiente arancione (chiaro → scuro) */
    background-image: linear-gradient(
      100deg,
      #ffd3ad 0%,
      #f0a060 25%,
      #e8804a 50%,
      #c0611a 75%,
      #8a3f0a 100%
    );
    background-size: 200% 100%;
    background-position: 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    text-shadow: none;
    transition: background-position 0.6s ease;
  }
  .brand-mark:hover .brand-word {
    background-position: 100% 50%;
  }

  /* ── Language toggle (segmented pill) ── */
  .lang-toggle {
    backdrop-filter: blur(6px);
    transition: border-color 0.3s ease;
  }
  .lang-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.45rem 0.6rem;
    border-radius: 999px;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-decoration: none;
    opacity: 0.55;
  }
  .lang-option:hover {
    opacity: 1;
    transform: translateY(-1px);
  }
  .lang-option.is-active {
    opacity: 1;
    background: rgba(0, 0, 0, 0.06);
  }
  :global(.dark) .lang-option.is-active {
    background: rgba(255, 255, 255, 0.12);
  }
  /* ── Mobile menu ── */
  .menu-toggle {
    color: var(--color-ink-900, #1c1d20);
    background: rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(28, 29, 32, 0.18);
    transition: border-color 0.3s ease, background-color 0.3s ease;
  }
  :global(.dark) .menu-toggle,
  .site-header.over-hero .menu-toggle {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.22);
  }
  .menu-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 15px;
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .menu-bar-top    { transform: translate(-50%, calc(-50% - 2.5px)); }
  .menu-bar-bottom { transform: translate(-50%, calc(-50% + 2.5px)); }
  .menu-toggle.is-open .menu-bar-top    { transform: translate(-50%, -50%) rotate(45deg); }
  .menu-toggle.is-open .menu-bar-bottom { transform: translate(-50%, -50%) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: -1; /* sotto la barra dell'header, che resta cliccabile */
    display: flex;
    align-items: center;
    background: var(--color-paper, #fafaf7);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  :global(.dark) .mobile-menu {
    background: var(--color-surface, #1c1d20);
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }
  .mobile-menu nav {
    width: 100%;
  }
  .mobile-menu-list {
    width: 100%;
    padding: 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
