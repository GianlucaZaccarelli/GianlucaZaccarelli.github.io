  /* ── CV button: stessa famiglia outline dei controlli accanto,
        in tinta terracotta per mantenere il ruolo di CTA ── */
  .cv-button {
    color: #b4531f;
    background: rgba(192, 97, 26, 0.14);
    border: 1px solid rgba(192, 97, 26, 0.45);
    transition: color 0.3s ease, background-color 0.3s ease,
                border-color 0.3s ease, transform 0.2s ease,
                box-shadow 0.3s ease;
  }
  :global(.dark) .cv-button {
