<script>
  /* ── Theme toggle: pulsante nell'header (da lg) e nel menu mobile ── */
  const themeButtons = Array.from(document.querySelectorAll<HTMLElement>('[data-theme-toggle]'));
  const header = document.getElementById('top') as HTMLElement | null;

  function updateTooltip(isDark: boolean) {
    themeButtons.forEach((b) => {
      const next = isDark ? b.dataset.labelLight : b.dataset.labelDark;
      if (b.hasAttribute('data-tooltip')) b.setAttribute('data-tooltip', next ?? '');
      const label = b.querySelector('[data-theme-label]');
      if (label) label.textContent = next ?? '';
      b.setAttribute('aria-pressed', String(isDark));
    });
  }

  updateTooltip(document.documentElement.classList.contains('dark'));

  function applyTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch {
      /* storage non disponibile: il tema vale solo per questa pagina */
    }
    updateTooltip(isDark);
  }

  // Il nuovo tema si spande dal pulsante come una macchia d'inchiostro
  // (View Transitions); senza supporto o con movimento ridotto cambia subito
  themeButtons.forEach((b) => b.addEventListener('click', () => {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || still) {
      applyTheme();
      return;
    }
    const r = b.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    const transition = document.startViewTransition(applyTheme);
    transition.ready.then(() => {
      document.documentElement.animate(
        { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 600, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', pseudoElement: '::view-transition-new(root)' }
      );
    });
  }));

  /* ── Sync tema tra tab aperti ── */
  window.addEventListener('storage', (e) => {
    if (e.key !== 'theme') return;
    const isDark = e.newValue === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    updateTooltip(isDark);
  });

  /* ── Scroll: header shadow + hero parallax + marquee direction (rAF throttled) ── */
  const heroBg = document.getElementById('hero-bg') as HTMLElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const parallaxEnabled = !reduceMotion && window.innerWidth > 720;
  if (parallaxEnabled && heroBg) heroBg.style.willChange = 'transform';

  // Animazione del marquee, creata da initMarquee
  let marqueeAnimation: Animation | null = null;

  const heroSection = document.getElementById('hero');

  let scrollScheduled = false;
  let lastScrollY = window.scrollY;
  let marqueeDir: 1 | -1 = 1;
  let menuOpen = false;
  function updateOverHero(y: number) {
    if (!header || !heroSection) return;
    // Col menu aperto l'header poggia sul fondo del menu, non sulla foto
    const overHero = !menuOpen && y < heroSection.offsetHeight - header.offsetHeight;
    header.classList.toggle('over-hero', overHero);
    header.classList.toggle('shadow-md', !overHero && y > 8);
  }
  updateOverHero(window.scrollY);

  function onScroll() {
    if (scrollScheduled) return;
    scrollScheduled = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      updateOverHero(y);
      aggiornaFolio();
      if (parallaxEnabled && heroBg) heroBg.style.transform = `translateY(${y * 0.35}px)`;
      const newDir: 1 | -1 = y > lastScrollY ? 1 : -1;
      if (newDir !== marqueeDir) {
        marqueeDir = newDir;
        if (marqueeAnimation) marqueeAnimation.playbackRate = newDir;
      }
      lastScrollY = y;
      scrollScheduled = false;
    });
  }
  window.addEventListener('scroll', onScroll, { passive: true });

  // Il folio passa al colore carta quando il suo centro sta sopra il retro di copertina
  const folioEl = document.getElementById('folio');
  const copertina = document.getElementById('contact');
  function aggiornaFolio() {
    if (!folioEl || !copertina) return;
    const r = copertina.getBoundingClientRect();
    const yFolio = window.innerHeight - 32 - 110;
    folioEl.classList.toggle('is-on-cover', r.top < yFolio && r.bottom > yFolio);
  }
  aggiornaFolio();

  /* ── Tab bar scrollspy ── */
  (function initTabSpy() {
    const tabs = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.tab-link[data-target]')
    );
    if (tabs.length === 0) return;

    const sections = tabs
      .map((tab) => {
        const id = tab.dataset.target?.replace('#', '');
        const el = id ? document.getElementById(id) : null;
        return el ? { tab, el } : null;
      })
      .filter((x): x is { tab: HTMLAnchorElement; el: HTMLElement } => x !== null);

    // Stessa voce attiva nella tab bar e nel menu mobile
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.tab-link[data-target], .mobile-menu-link[data-target]')
    );
    const folio = document.getElementById('folio');
    const folioNum = folio?.querySelector('.folio-num');
    const folioLabel = folio?.querySelector('.folio-label');
    const updateFolio = (tab: HTMLAnchorElement | null) => {
      if (!folio || !folioNum || !folioLabel) return;
      folio.classList.toggle('is-visible', !!tab);
      if (!tab) return;
      const num = String(tabs.indexOf(tab) + 1).padStart(2, '0');
      if (folioNum.textContent === num) return;
      folioNum.textContent = num;
      folioLabel.textContent = tab.textContent?.trim() ?? '';
      if (!reduceMotion) {
        folio.querySelector('.folio-text')?.animate(
          [{ opacity: 0, transform: 'translateY(-6px)' }, { opacity: 1, transform: 'none' }],
          { duration: 420, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
        );
      }
    };

    const tabBar = document.querySelector<HTMLElement>('.tab-bar');
    const indicator = tabBar?.querySelector<HTMLElement>('.tab-indicator');
    tabBar?.classList.add('has-indicator');
    let indicatorPlaced = false;
    const moveIndicator = (tab: HTMLAnchorElement | null) => {
      if (!indicator) return;
      indicator.classList.toggle('is-visible', !!tab);
      if (!tab || tab.offsetWidth === 0) return; // tab bar nascosta sotto lg
      // La prima volta compare già al suo posto, poi scivola
      indicator.classList.toggle('no-anim', !indicatorPlaced);
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translateX(${tab.parentElement?.offsetLeft ?? 0}px)`;
      indicatorPlaced = true;
    };

    const setActive = (tab: HTMLAnchorElement | null) => {
      updateFolio(tab);
      moveIndicator(tab);
      const target = tab?.dataset.target;
      links.forEach((l) => {
        const on = !!target && l.dataset.target === target;
        l.classList.toggle('is-active', on);
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
      });
    };

    // Tiene traccia delle sezioni nella banda di osservazione: se nessuna
    // è visibile (es. hero) nessuna tab resta evidenziata
    const visibleSections = new Set<Element>();
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) visibleSections.add(e.target);
          else visibleSections.delete(e.target);
        });
        if (visibleSections.size === 0) {
          setActive(null);
          return;
        }
        const firstVisible = sections.find((s) => visibleSections.has(s.el));
        if (firstVisible) setActive(firstVisible.tab);
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );

    sections.forEach(({ el }) => observer.observe(el));
  })();

  /* ── Mobile menu ── */
  (function initMobileMenu() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;

    const labelOpen = toggle.getAttribute('aria-label') ?? 'Menu';
    const labelClose = toggle.dataset.labelClose ?? labelOpen;

    function setOpen(open: boolean) {
      if (!toggle || !menu) return;
      menu.classList.toggle('is-open', open);
      toggle.classList.toggle('is-open', open);
      // Dietro il menu la pagina e' inerte: il Tab resta nel menu e nella barra
      document.querySelectorAll<HTMLElement>('main, #hero, footer, #folio').forEach((el) => (el.inert = open));
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labelClose : labelOpen);
      document.body.style.overflow = open ? 'hidden' : '';
      menuOpen = open;
      updateOverHero(window.scrollY);
      // Il focus entra nel menu all'apertura e torna al pulsante alla chiusura
      if (open) menu.querySelector<HTMLElement>('.mobile-menu-link')?.focus({ preventScroll: true });
      else if (menu.contains(document.activeElement)) toggle.focus({ preventScroll: true });
    }

    toggle.addEventListener('click', () => {
      setOpen(!menu.classList.contains('is-open'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.classList.contains('is-open')) setOpen(false);
    });

    // Da lg il menu è nascosto: se era aperto va chiuso, o lo scroll resta bloccato
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  })();

  /* ── Marquee rolling (WAAPI) — direzione gestita dallo scroll listener unificato ── */
  (function initMarquee() {
    const inner   = document.getElementById('hero-marquee-inner');
    const textEl  = inner?.querySelector('.hero-marquee-text') as HTMLElement | null;
    // Con movimento ridotto il nome resta fermo
    if (!inner || !textEl || reduceMotion) return;
    let lastWidth = window.innerWidth;
    let rebuildScheduled = false;

    const build = () => {
      inner.querySelectorAll('.hero-marquee-clone').forEach((el) => el.remove());
      const totalW = textEl.offsetWidth;
      if (totalW === 0) return;
      const needed = Math.ceil((window.innerWidth * 3) / totalW) + 1;
      for (let i = 0; i < needed; i++) {
        const clone = textEl.cloneNode(true) as HTMLElement;
        clone.classList.add('hero-marquee-clone');
        inner.appendChild(clone);
      }

      const totalChildren = inner.children.length;
      const distancePct = 100 / totalChildren;
      marqueeAnimation?.cancel();
      marqueeAnimation = inner.animate(
        [{ transform: 'translateX(0)' }, { transform: `translateX(-${distancePct}%)` }],
        { duration: 22000, iterations: Infinity, easing: 'linear' }
      );
    };

    build();

    // Resize debounced via rAF; rebuild solo se la larghezza orizzontale è cambiata
    // (su mobile la barra indirizzi che si chiude triggera un resize verticale).
    const scheduleRebuild = () => {
      if (rebuildScheduled) return;
      rebuildScheduled = true;
      requestAnimationFrame(() => {
        if (window.innerWidth !== lastWidth) {
          lastWidth = window.innerWidth;
          build();
        }
        rebuildScheduled = false;
      });
    };
    window.addEventListener('resize', scheduleRebuild, { passive: true });
  })();
</script>
