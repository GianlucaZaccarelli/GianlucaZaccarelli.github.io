---
interface Props {
  country: 'it' | 'gb';
  class?: string;
}

const { country, class: className = 'flag' } = Astro.props;
---

{country === 'it' ? (
  <svg class={className} viewBox="0 0 3 2" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <rect width="1" height="2" x="0" fill="#009246"/>
    <rect width="1" height="2" x="1" fill="#ffffff"/>
    <rect width="1" height="2" x="2" fill="#ce2b37"/>
  </svg>
) : (
  <svg class={className} viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <g>
      <rect width="60" height="30" fill="#012169"/>
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#ffffff" stroke-width="6"/>
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#c8102e" stroke-width="4"/>
      <path d="M30,0 V30 M0,15 H60" stroke="#ffffff" stroke-width="10"/>
      <path d="M30,0 V30 M0,15 H60" stroke="#c8102e" stroke-width="6"/>
    </g>
  </svg>
)}

<style>
  .flag {
    width: 1.15rem;
    height: 0.8rem;
    border-radius: 2px;
    display: block;
    box-shadow: 0 0 0 0.5px rgba(0, 0, 0, 0.15);
    overflow: hidden;
  }
</style>
