---
import { Picture } from 'astro:assets';
import { getPersonal } from '../data/personal';
import type { Locale } from '../data/types';

interface Props {
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;
const personal = getPersonal(locale);
const galleryLabel = locale === 'en' ? 'Photo gallery' : 'Galleria fotografica';
// Provini a due colonne anche su mobile; da md ogni colonna è al massimo 22rem (vedi .gallery)
const cols = Math.min(personal.photos.length, 3);
const sizes = cols === 1 ? '(min-width: 768px) 352px, calc(100vw - 48px)' : '(min-width: 768px) 352px, calc(50vw - 36px)';
---

<section id="personal" class="relative py-24 md:py-32 bg-paper dark:bg-surface-alt overflow-clip">
  <div class="max-w-6xl mx-auto px-6">

    <h2 class="section-title">
      <span class="section-num" aria-hidden="true">07</span>{personal.title} <em>{personal.titleEm}</em>
    </h2>
    <p class="meta-mono -mt-8 mb-10 text-sm tracking-wide text-accent-700 dark:text-accent-400">{personal.since}</p>

    <div class="grid grid-cols-12 gap-x-6 gap-y-10">
      <p class="editorial-lead col-span-12 md:col-span-9">
        {personal.lead}
      </p>

      {personal.chapters.map((c, i) => (
        <div class:list={['col-span-12 md:col-span-5', { 'md:col-start-7': i % 2 === 1 }]}>
          <h3 class="meta-label mb-3 tracking-normal leading-snug">
            <span class="meta-mono text-accent-700 dark:text-accent-400">{String(i + 1).padStart(2, '0')}</span> — {c.kicker}
          </h3>
          <p class="text-ink-700 dark:text-white/70 text-base md:text-lg leading-relaxed">{c.body}</p>
        </div>
      ))}

      <p class="personal-note col-span-12 md:col-span-8">{personal.note}</p>
    </div>

    {personal.photos.length > 0 && (
      <ul class="gallery mt-16 md:mt-24" aria-label={galleryLabel} style={`--cols: ${cols}`}>
        {personal.photos.map((p, i) => (
          <li>
            <figure>
              <Picture
                src={p.image}
                alt={p.alt}
                formats={['avif', 'webp']}
                widths={[360, 560, 720, 1080]}
                sizes={sizes}
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
              <figcaption class="meta-mono">
                <span class="text-accent-700 dark:text-accent-400">Fig. {String(i + 1).padStart(2, '0')}</span>
                {p.caption && <> — {p.caption}</>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

  </div>
</section>

<style>
  .personal-note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 1.6vw, 1.45rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--color-accent-700);
    font-variation-settings: 'opsz' 48, 'SOFT' 100;
  }
  :global(.dark) .personal-note { color: var(--color-accent-400); }

  /* Provini da rivista: tante colonne quante foto (fino a 3, due su mobile), allineate
     in alto, ogni foto nel suo formato. Colonne da 22rem al massimo: la galleria
     accompagna il testo invece di schiacciare il retro di copertina che segue */
  .gallery {
    display: grid;
    grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
    gap: 2rem 1rem;
    align-items: start;
    max-width: calc(var(--cols) * 22rem + (var(--cols) - 1) * 1.5rem);
  }
  @media (min-width: 768px) {
    .gallery { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); column-gap: 1.5rem; }
  }
  /* Cornice: passe-partout carta e filetto sottile, come una stampa in rivista */
  .gallery :global(img) {
    padding: 0.4rem;
    background: #fff;
    border: 1px solid color-mix(in oklch, var(--color-ink-300) 70%, transparent);
  }
  :global(.dark) .gallery :global(img) {
    background: var(--color-surface-card);
    border-color: rgba(255, 255, 255, 0.14);
  }
  .gallery figcaption {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-ink-500);
  }
  :global(.dark) .gallery figcaption { color: rgba(255, 255, 255, 0.55); }
</style>
