---
import '../styles/global.css';
import LoadingScreen from '../components/LoadingScreen.astro';
import { getProfile, socialLinks } from '../data/profile';
import { getKnowsAbout } from '../data/skills';
import type { Locale } from '../data/types';
import ogImageAsset from '../assets/og-image.jpg';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import interLatinWght from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const { locale = 'it' } = Astro.props;

const defaultMeta = locale === 'en'
  ? {
      title: 'Gianluca Zaccarelli — Senior Full-Stack Developer',
      description:
        'Portfolio and curriculum vitae of Gianluca Zaccarelli, Senior Full-Stack Developer with experience in C#, .NET, microservices, Docker and enterprise development.',
    }
  : {
      title: 'Gianluca Zaccarelli — Sviluppatore Full-Stack Senior',
      description:
        'Portfolio e curriculum vitae di Gianluca Zaccarelli, Sviluppatore Full-Stack Senior con esperienza in C#, .NET, microservizi, Docker e sviluppo enterprise.',
    };

const {
  title = defaultMeta.title,
  description = defaultMeta.description,
} = Astro.props;

const profile = getProfile(locale);

const siteUrl = (Astro.site ?? new URL('https://gianlucazaccarelli.github.io')).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
// Immagine social dedicata 1200×630 (1.91:1, formato di summary_large_image)
const ogImage = new URL(ogImageAsset.src, siteUrl).toString();
const ogLocale = locale === 'en' ? 'en_US' : 'it_IT';
const ogLocaleAlternate = locale === 'en' ? 'it_IT' : 'en_US';
const skipLabel = locale === 'en' ? 'Skip to content' : 'Salta al contenuto';

const itHref = new URL('/', siteUrl).toString();
const enHref = new URL('/en/', siteUrl).toString();

const knowsAbout = getKnowsAbout(locale);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.nickname,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  url: siteUrl,
  image: ogImage,
  address: {
    '@type': 'PostalAddress',
    addressLocality: profile.city,
    addressCountry: profile.country,
  },
  knowsAbout,
  knowsLanguage: locale === 'en' ? ['Italian', 'English'] : ['Italiano', 'Inglese'],
  sameAs: socialLinks.filter((l) => l.icon !== 'mail').map((l) => l.href),
  subjectOf: {
    '@type': 'DigitalDocument',
    name: locale === 'en' ? 'Curriculum Vitae (PDF, English)' : 'Curriculum Vitae (PDF, italiano)',
    inLanguage: locale,
    url: new URL(profile.cvPath, siteUrl).toString(),
    encodingFormat: 'application/pdf',
  },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang alternates (SEO multilingua) -->
    <link rel="alternate" hreflang="it" href={itHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="x-default" href={itHref} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(ogImageAsset.width)} />
    <meta property="og:image:height" content={String(ogImageAsset.height)} />
    <meta property="og:image:alt" content={profile.name} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:site_name" content={profile.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={profile.name} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Preload font primari per LCP (hero usa Fraunces; body usa Inter) -->
    <link rel="preload" as="font" type="font/woff2" href={frauncesLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={interLatinWght} crossorigin />

    <!-- Theme color (browser chrome) -->
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1c1d20" media="(prefers-color-scheme: dark)" />

    <!-- JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    {
      import.meta.env.PROD && import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
        <script
          is:inline
          defer
          data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
          src="https://plausible.io/js/script.js"
        />
      )
    }

    <title>{title}</title>

    <!-- Before paint: dark class (no flash) + intro skip (no overlay flash) -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        let saved = null;
        let introSeen = false;
        try {
          saved = localStorage.getItem('theme');
          introSeen = sessionStorage.getItem('zakka:intro-seen') === '1';
        } catch {
          introSeen = true;
        }
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) root.classList.add('dark');
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (introSeen || reduceMotion) root.classList.add('no-intro');
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-to-content">{skipLabel}</a>
    <LoadingScreen />
    <slot />
  </body>
</html>
